{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "description": "pgvector release used in the Dockerfile base image tag (Dependabot cannot resolve the ARG-templated FROM line)",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG PGVECTOR_VERSION=(?<currentValue>\d+\.\d+\.\d+)"
      ],
      "depNameTemplate": "pgvector/pgvector",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>\d+\.\d+\.\d+)-pg18-trixie$"
    }
  ],
  "packageRules": [
    {
      "description": "Pin GitHub Actions to commit SHAs (kept readable with a version comment)",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
